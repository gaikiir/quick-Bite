rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // DEVELOPMENT RULES - TEMPORARY 
    // ========================================
    // NOTE: These are permissive rules for development
    // Replace with proper security rules before production

    // Allow public read access to categories and products
    match /categories/{categoryId} {
      allow read: if true; // Public read for browsing
      allow write: if request.auth != null; // Any authenticated user can write for now
    }

    match /products/{productId} {
      allow read: if true; // Public read for browsing
      allow write: if request.auth != null; // Any authenticated user can write for now
    }

    // Users can manage their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own wishlists
    match /wishlists/{wishlistId} {
      allow read, write: if request.auth != null;
    }

    // Users can manage their own carts
    match /carts/{cartId} {
      allow read, write: if request.auth != null;
    }

    // Users can manage their own orders
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Admin collection - any authenticated user for development
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Default rule for development - allow authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
